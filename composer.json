{
    "name": "kuma-develop/level",
    "description": "EXP and level system for Flarum 2.0 / Hệ thống EXP và cấp độ cho Flarum 2.0",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "kuma-develop",
            "role": "Developer"
        }
    ],
    "require": {
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "KumaDevelop\\Level\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Levels",
            "category": "feature",
            "icon": {
                "name": "fas fa-star",
                "color": "#ffffff",
                "backgroundColor": "#f59e0b"
            }
        }
    }
}
